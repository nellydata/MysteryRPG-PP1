{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build COS-PP1 Debug x64",
            "type": "process",
            "command": "${env:ProgramFiles}/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}/dev/COS-PP1.slnx",
                "/m",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Run COS-PP1 (console)",
            "type": "process",
            "command": "${workspaceFolder}/dev/bin/x64/Debug/COS-PP1.exe",
            "options": { "cwd": "${workspaceFolder}/dev" },
            "dependsOn": "Build COS-PP1 Debug x64",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
        }
    ]
}
