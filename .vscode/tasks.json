{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Micare (Debug x64)",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}/dev/COS-PP1.slnx",
                "/m",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/nologo"
            ],
            "options": {
                "cwd": "${workspaceFolder}/dev"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run Micare (console)",
            "type": "process",
            "command": "${workspaceFolder}/dev/bin/x64/Debug/COS-PP1.exe",
            "options": {
                "cwd": "${workspaceFolder}/dev"
            },
            "dependsOn": "Build Micare (Debug x64)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        }
    ]
}
